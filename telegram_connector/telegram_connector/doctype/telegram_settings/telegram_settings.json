{
 "doctype": "DocType",
 "name": "Telegram Settings",
 "module": "Telegram Connector",
 "engine": "InnoDB",
 "sort_field": "creation",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled"
  },
  {
   "fieldname": "mode",
   "fieldtype": "Select",
   "label": "Mode",
   "options": "Bot\nUser Account",
   "default": "Bot",
   "reqd": 1,
   "description": "Bot = رسمي وآمن (العميل يضغط Start). User Account = إرسال برقم الموبايل بحساب شخصي (خطر حظر)."
  },
  {
   "fieldname": "default_country_code",
   "fieldtype": "Data",
   "label": "Default Country Code",
   "default": "20"
  },
  {
   "fieldname": "sec_bot",
   "fieldtype": "Section Break",
   "label": "Bot",
   "depends_on": "eval:doc.mode=='Bot'"
  },
  {
   "fieldname": "bot_token",
   "fieldtype": "Password",
   "label": "Bot Token"
  },
  {
   "fieldname": "bot_username",
   "fieldtype": "Data",
   "label": "Bot Username",
   "read_only": 1
  },
  {
   "fieldname": "link_method",
   "fieldtype": "Select",
   "label": "Link Method",
   "options": "Polling\nWebhook",
   "default": "Polling",
   "description": "Polling لا يحتاج رابط عام. Webhook يحتاج HTTPS عام."
  },
  {
   "fieldname": "btn_test_connection",
   "fieldtype": "Button",
   "label": "Test Connection"
  },
  {
   "fieldname": "btn_set_webhook",
   "fieldtype": "Button",
   "label": "Set Webhook",
   "depends_on": "eval:doc.link_method=='Webhook'"
  },
  {
   "fieldname": "webhook_secret",
   "fieldtype": "Password",
   "label": "Webhook Secret",
   "hidden": 1
  },
  {
   "fieldname": "last_update_id",
   "fieldtype": "Int",
   "label": "Last Update Id",
   "hidden": 1
  },
  {
   "fieldname": "sec_acc",
   "fieldtype": "Section Break",
   "label": "User Account",
   "depends_on": "eval:doc.mode=='User Account'"
  },
  {
   "fieldname": "api_id",
   "fieldtype": "Data",
   "label": "Api Id"
  },
  {
   "fieldname": "api_hash",
   "fieldtype": "Password",
   "label": "Api Hash"
  },
  {
   "fieldname": "login_phone",
   "fieldtype": "Data",
   "label": "Login Phone"
  },
  {
   "fieldname": "btn_send_code",
   "fieldtype": "Button",
   "label": "Send Code"
  },
  {
   "fieldname": "login_code",
   "fieldtype": "Data",
   "label": "Login Code"
  },
  {
   "fieldname": "two_fa_password",
   "fieldtype": "Password",
   "label": "Two Fa Password",
   "description": "لو الحساب عليه Two-Step Verification"
  },
  {
   "fieldname": "btn_verify",
   "fieldtype": "Button",
   "label": "Verify & Login"
  },
  {
   "fieldname": "account_status",
   "fieldtype": "Data",
   "label": "Account Status",
   "read_only": 1
  },
  {
   "fieldname": "session_string",
   "fieldtype": "Password",
   "label": "Session String",
   "read_only": 1
  },
  {
   "fieldname": "tmp_session",
   "fieldtype": "Password",
   "label": "Tmp Session",
   "hidden": 1
  },
  {
   "fieldname": "tmp_hash",
   "fieldtype": "Data",
   "label": "Tmp Hash",
   "hidden": 1
  },
  {
   "fieldname": "sec_test",
   "fieldtype": "Section Break",
   "label": "Test"
  },
  {
   "fieldname": "test_recipient",
   "fieldtype": "Data",
   "label": "Test Recipient",
   "description": "Bot: chat id رقمي — Account: رقم موبايل"
  },
  {
   "fieldname": "test_text",
   "fieldtype": "Data",
   "label": "Test Text",
   "default": "تجربة من ERPNext ✅"
  },
  {
   "fieldname": "btn_send_test",
   "fieldtype": "Button",
   "label": "Send Test Message"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  }
 ],
 "issingle": 1
}