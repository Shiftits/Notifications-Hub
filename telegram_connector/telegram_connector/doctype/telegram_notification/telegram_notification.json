{
 "doctype": "DocType",
 "name": "Telegram Notification",
 "module": "Telegram Connector",
 "engine": "InnoDB",
 "sort_field": "creation",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": 1
  },
  {
   "fieldname": "document_type",
   "fieldtype": "Link",
   "label": "Document Type",
   "options": "DocType",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "event",
   "fieldtype": "Select",
   "label": "Event",
   "options": "New\nSave\nSubmit\nCancel",
   "default": "Submit",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "condition",
   "fieldtype": "Code",
   "label": "Condition",
   "options": "PythonExpression",
   "description": "اختياري. مثال: doc.grand_total > 100"
  },
  {
   "fieldname": "sec_rec",
   "fieldtype": "Section Break",
   "label": "Recipient"
  },
  {
   "fieldname": "mobile_field",
   "fieldtype": "Data",
   "label": "Mobile Field",
   "description": "حقل الموبايل في المستند، مثال: contact_mobile"
  },
  {
   "fieldname": "party_field",
   "fieldtype": "Data",
   "label": "Party Field",
   "description": "حقل الطرف في المستند، مثال: customer"
  },
  {
   "fieldname": "party_doctype",
   "fieldtype": "Link",
   "label": "Party Doctype",
   "options": "DocType",
   "description": "مثال: Customer"
  },
  {
   "fieldname": "party_mobile_field",
   "fieldtype": "Data",
   "label": "Party Mobile Field",
   "description": "حقل الموبايل في الطرف، مثال: mobile_no"
  },
  {
   "fieldname": "prefer_party_mobile",
   "fieldtype": "Check",
   "label": "Prefer Party Mobile",
   "description": "استخدم رقم الطرف قبل رقم المستند"
  },
  {
   "fieldname": "sec_msg",
   "fieldtype": "Section Break",
   "label": "Message"
  },
  {
   "fieldname": "message",
   "fieldtype": "Code",
   "label": "Message",
   "options": "Jinja",
   "reqd": 1,
   "description": "استخدم doc، مثال: {{ doc.name }}"
  },
  {
   "fieldname": "attach_print",
   "fieldtype": "Check",
   "label": "Attach PDF"
  },
  {
   "fieldname": "print_format",
   "fieldtype": "Link",
   "label": "Print Format",
   "options": "Print Format",
   "depends_on": "attach_print"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1
  }
 ],
 "autoname": "field:title"
}